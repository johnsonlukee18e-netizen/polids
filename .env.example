# cp .env.example .env
# .env jest w .gitignore - klucze i hasła tylko tam

POLIDS_PUBLIC_URL=http://localhost:1337
#POLIDS_PORT=1337

# none / dev / vatsim (dev = formularz testowy, działa tylko na localhost)
POLIDS_AUTH_MODE=dev
# klucz sesji: openssl rand -hex 32
#POLIDS_SECRET_KEY=
#POLIDS_SESSION_DAYS=7

# VATSIM Connect, redirect URI: <POLIDS_PUBLIC_URL>/auth/callback
# sandbox: https://auth-dev.vatsim.net (konta 10000000-10000010, hasło = CID)
#POLIDS_VATSIM_AUTH_URL=https://auth.vatsim.net
#POLIDS_VATSIM_CLIENT_ID=
#POLIDS_VATSIM_CLIENT_SECRET=

# administratorzy (CID, po przecinku) - zawsze mają dostęp i zarządzają listą w zakładce ADMIN,
# reszta wchodzi tylko, jeśli admin doda ich CID
#POLIDS_AUTH_ADMIN_CIDS=

POLIDS_DEFAULT_AERODROME=EPWA
# METAR: vatsim albo awc
POLIDS_METAR_SOURCE=vatsim

# eAIP - zmieniać co AIRAC
#POLIDS_AIP_IFR_URL=https://docs.pansa.pl/ais/eaipifr/AIRAC%20AMDT%2010-26_2026_10_01/index-v2.html
#POLIDS_AIP_VFR_URL=https://docs.pansa.pl/ais/eaipvfr/AIRAC%20AMDT%20VFR%2010-26_2026_10_01/index-v2.html
#POLIDS_AIP_MIL_URL=https://docs.pansa.pl/ais/eaipmil/AIRAC%20AMDT%20MIL%2010-26_2026_10_01/index-v2.html

#POLIDS_NOTAM_SERVER=https://cv.plvacc.pl/
#POLIDS_NOTAM_PREFIX=notam/get-icao-format?icao=
#POLIDS_NOTAM_SUFFIX=&read=true

# mapy: openaip.net i carto.com/basemaps/apikey (CARTO na serwerze ograniczyć do domeny)
#POLIDS_OPENAIP_API_KEY=
#POLIDS_CARTO_API_KEY=

# vIFF działa bez klucza
#POLIDS_VIFF_URL=https://api.viffsys.com
#POLIDS_VIFF_API_KEY=
#POLIDS_VIFF_CDM_AIRPORTS=EPWA

# tylko serwer (docker-compose.prod.yml)
#DOMAIN=polids.example.pl
#ACME_EMAIL=admin@example.pl
#POLIDS_IMAGE=ghcr.io/<org>/polids:latest
